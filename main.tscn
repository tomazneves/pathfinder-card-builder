[node name="Card1" parent="Cards" unique_id=180015982 instance=ExtResource("2_h2yge")]
layout_mode = 2
card_name = "Flaming Boots"
card_category = "Item 4"
card_traits = Array[String](["fire", "Manipulate", "arcane", "magical"])
card_duration = "1 minute"
card_description = "With a sudden kick, you conjure a dense ball of flame at your feet for one minute, after which it sizzles out. This counts as a 2nd-rank Floating Flame spell, but doesn't have the Concentrate trait. You can Dismiss the ball by stomping on it as an Interact action.

As part of the activation and as a 1-action Interact activity henceforth, you can kick the ball up to 30 feet in any direction, and it is affected by gravity normally. The ball's trajectory is stopped by barriers, but it can bounce off them up to the GM's discretion. Any creature or object in the ball's path takes 3d6 fire damage on a basic Reflex save. A creature can only take this damage once per round.

If at the end of your turn the ball is in water, it produces steaming fog in a 5-foot emmanation around itself and loses one extra round of duration."

[node name="Card2" parent="Cards" unique_id=1634364181 instance=ExtResource("2_h2yge")]
layout_mode = 2
card_type = 3
card_name = "Fly"
card_category = "Spell 4"
card_traits = Array[String](["Concentrate", "Manipulate"])
card_traditions = Array[String](["Arcane", "Primal", "Divine", "Occult"])
card_range = "touch"
card_duration = "5 minutes"
card_description = "The target can soar through the air, gaining a fly Speed equal to its Speed or 20 feet, whichever is greater."

[node name="Card3" parent="Cards" unique_id=1201863392 instance=ExtResource("2_h2yge")]
layout_mode = 2
card_name = "Chromatic Ray"
card_category = "Spell 4"
card_traits = Array[String](["Attack", "Concentrate", "Manipulate", "Light"])
card_traditions = Array[String](["Arcane", "Occult"])
card_range = "30 feet"
card_defense = "AC"
card_description = "You send out a ray of colored light streaming toward your enemy, with a magical effect depending on the ray's color. Make a spell attack roll. If you hit, roll 1d4 to see which beam you cast. If the ray deals damage, that damage is doubled on a critical hit. Any additional traits that apply to a ray are listed in parentheses just after the name of the color.

[ol]
[li]Red (fire) The ray deals 30 fire damage to the target.[/li]
[li]Orange (acid) The ray deals 40 acid damage to the target.[/li]
[li]Yellow (electricity) The ray deals 50 electricity damage to the target.[/li]
[li]Green (poison) The ray deals 25 poison damage to the target, and the target must succeed at a Fortitude save or be enfeebled 1 for 1 minute (enfeebled 2 on a critical failure).[/li]
[/ol]"

[node name="Card4" parent="Cards" unique_id=926444857 instance=ExtResource("2_h2yge")]
layout_mode = 2
card_name = "Gravity Bracers"
card_category = "Item 4"
card_traits = Array[String](["Concentrate", "Manipulate"])
card_range = "120 feet"
card_targets = "1 creature or object"
card_defense = "Fortitude"
card_requirements = "You have a hand free"
card_description = "You clutch your arms focusing on a target you can locate. If it is smaller than you, it is pulled 60 ft toward you; if it is larger, you are pulled 60 ft towards it. If it is the same size as you, you and the target are both pulled 30 ft towards each other. This is forced movement and is blocked by sturdy physical barriers.

You cand the target can attempt DC 16 Fortitude saves to resist this movement up to the GM's discretion. A creature that resists is treated as the larger of the interaction. If both user and target succeed, the attempt is wasted, but the bracers don't immediately lose their magic for the day.

A creature can resist an attempt on an item it is carrying or wearing if it can hold onto it."

[node name="Card5" parent="Cards" unique_id=885759371 instance=ExtResource("2_h2yge")]
layout_mode = 2
card_name = "ReplicateRReplicateReplicateReplicate"
card_category = "Spell 4"
card_traits = Array[String](["subtle", "shadow", "concentrate", "manipulate"])
card_traditions = Array[String](["Arcane", "Occult"])
card_targets = "1 willing or unconscious creature up to 8th level"
card_description = "You create an illusory magical double that physically looks and behaves very similarly to the target. This double is limited to moving, Interacting, speaking short sentences, and other similar basic tasks. It is unable to cast spells, attack, or use any complex skills.The illusory duplicate is your minion. You can issue new commands to the double as part of Sustaining the Spell. You can command the duplicate telepathically as long as the spell lasts, provided it's within 1 mile of you. You can switch between using your own senses and the duplicate's senses with a single action, which has the concentrate trait. The illusory duplicate has the same statistics as the original creature, except it doesn't have any of the original's item bonuses, and it has one quarter of the original's Hit Points. If the double's Hit Points are reduced to 0, the spell ends."

